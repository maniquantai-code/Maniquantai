{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "rewrites": [
    { "source": "/api/broker-accounts", "destination": "/python/index.py?__path=/api/broker-accounts" },
    { "source": "/api/broker-accounts/:path*", "destination": "/python/index.py?__path=/api/broker-accounts/:path*" },
    { "source": "/api/wallet", "destination": "/python/index.py?__path=/api/wallet" },
    { "source": "/api/wallet/:path*", "destination": "/python/index.py?__path=/api/wallet/:path*" },
    { "source": "/api/mt5-bridge/:path*", "destination": "/python/index.py?__path=/api/mt5-bridge/:path*" },
    { "source": "/api/chat", "destination": "/python/index.py?__path=/api/chat" },
    { "source": "/api/pipeline/:path*", "destination": "/python/index.py?__path=/api/pipeline/:path*" },
    { "source": "/api/strategies", "destination": "/python/index.py?__path=/api/strategies" },
    { "source": "/api/strategies/:path*", "destination": "/python/index.py?__path=/api/strategies/:path*" },
    { "source": "/api/live-trading/:path*", "destination": "/python/index.py?__path=/api/live-trading/:path*" },
    { "source": "/api/live-engine/:path*", "destination": "/python/index.py?__path=/api/live-engine/:path*" },
    { "source": "/api/paper-decision/:path*", "destination": "/python/index.py?__path=/api/paper-decision/:path*" },
    { "source": "/api/llm/:path*", "destination": "/python/index.py?__path=/api/llm/:path*" },
    { "source": "/api/strategy-compiler/:path*", "destination": "/python/index.py?__path=/api/strategy-compiler/:path*" },
    { "source": "/api/health", "destination": "/python/index.py?__path=/api/health" }
  ]
}
